# Copy to `.env.local` in the project root and fill in from Firebase:
#   Firebase console → Project settings → General → Your apps (Web) → config object
#
# Vite only exposes env vars that start with VITE_

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Google Analytics in the Firebase client (G-…)
VITE_FIREBASE_MEASUREMENT_ID=
