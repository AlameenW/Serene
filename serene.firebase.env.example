# Copy this file to `.env.local` (gitignored) and fill in your own Firebase project's values.
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled on the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=

# Google AI Studio API key, used by the Support page's Gemini chat
VITE_GEMINI_API_KEY=
